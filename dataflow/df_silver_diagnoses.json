{
	"name": "df_silver_diagnoses",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_diagnoses_sql",
						"type": "DatasetReference"
					},
					"name": "bronzeDiagnoses"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "silverAdmissionsRef"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_diagnoses_sql",
						"type": "DatasetReference"
					},
					"name": "silverDiagnoses"
				}
			],
			"transformations": [
				{
					"name": "limpiezaDiagnosticos"
				},
				{
					"name": "filtrarInvalidosDiag"
				},
				{
					"name": "quitarDuplicadosDiag"
				},
				{
					"name": "soloAdmisionesValidas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronzeDiagnoses",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> silverAdmissionsRef",
				"bronzeDiagnoses derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          icd_code = iifNull(iif(length(regexReplace(upper(trim(split(icd_code,',')[1])),'[^A-Z0-9]',''))>3, concat(substring(regexReplace(upper(trim(split(icd_code,',')[1])),'[^A-Z0-9]',''),1,3),'.',substring(regexReplace(upper(trim(split(icd_code,',')[1])),'[^A-Z0-9]',''),4)), regexReplace(upper(trim(split(icd_code,',')[1])),'[^A-Z0-9]','')),''),",
				"          diagnosis_description = iifNull(trim(diagnosis_description), ''),",
				"          severity = iif(iifNull(length(trim(severity)),0)==0, toString(null()), initCap(lower(trim(severity))))) ~> limpiezaDiagnosticos",
				"limpiezaDiagnosticos filter(!isNull(diagnosis_id) && !isNull(admission_id) && icd_code != '') ~> filtrarInvalidosDiag",
				"filtrarInvalidosDiag aggregate(groupBy(diagnosis_id),",
				"     admission_id = first(admission_id),",
				"          icd_code = first(icd_code),",
				"          diagnosis_description = first(diagnosis_description),",
				"          severity = first(severity)) ~> quitarDuplicadosDiag",
				"quitarDuplicadosDiag, silverAdmissionsRef exists(quitarDuplicadosDiag@admission_id == silverAdmissionsRef@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> soloAdmisionesValidas",
				"soloAdmisionesValidas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> silverDiagnoses"
			]
		}
	}
}