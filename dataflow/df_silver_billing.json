{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_billing_sql",
						"type": "DatasetReference"
					},
					"name": "bronzeBilling"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "silverAdmissionsRef"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "silverBilling"
				}
			],
			"transformations": [
				{
					"name": "limpiezaFacturacion"
				},
				{
					"name": "filtrarInvalidosFact"
				},
				{
					"name": "quitarDuplicadosFact"
				},
				{
					"name": "soloAdmisionesValidas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronzeBilling",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> silverAdmissionsRef",
				"bronzeBilling derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          charge_type = iif(iifNull(length(trim(charge_type)),0)==0, 'Unknown', initCap(lower(trim(charge_type)))),",
				"          amount = toDecimal(round(toDouble(regexReplace(amount,'[^0-9.]','')), 2), 12, 2),",
				"          payment_status = iifNull(initCap(lower(trim(payment_status))), ''),",
				"          payment_date = coalesce(iif(regexMatch(payment_date,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(payment_date,'yyyy-MM-dd'), toDate(null())), toDate(payment_date,'MM/dd/yyyy'), toDate(payment_date,'dd-MMM-yyyy'), toDate(payment_date,'MMMM d, yyyy'), toDate(payment_date,'MM-dd-yy'))) ~> limpiezaFacturacion",
				"limpiezaFacturacion filter(!isNull(billing_id) && !isNull(admission_id) && !isNull(amount)) ~> filtrarInvalidosFact",
				"filtrarInvalidosFact aggregate(groupBy(billing_id),",
				"     admission_id = first(admission_id),",
				"          charge_type = first(charge_type),",
				"          amount = first(amount),",
				"          payment_status = first(payment_status),",
				"          payment_date = first(payment_date)) ~> quitarDuplicadosFact",
				"quitarDuplicadosFact, silverAdmissionsRef exists(quitarDuplicadosFact@admission_id == silverAdmissionsRef@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> soloAdmisionesValidas",
				"soloAdmisionesValidas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> silverBilling"
			]
		}
	}
}