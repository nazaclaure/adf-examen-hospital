{
	"name": "df_silver_patients",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_patients_sql",
						"type": "DatasetReference"
					},
					"name": "bronzePatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "silverPatients"
				}
			],
			"transformations": [
				{
					"name": "limpiezaPacientes"
				},
				{
					"name": "vaciosANulo"
				},
				{
					"name": "claveDuplicado"
				},
				{
					"name": "numerarDuplicados"
				},
				{
					"name": "quedarseConUno"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronzePatients",
				"bronzePatients derive(patient_id = toInteger(trim(patient_id)),",
				"          full_name = trim(regexReplace(regexReplace(regexReplace(iifNull(trim(full_name), ''), '[^A-Za-z .-]', ''), '(^|[ ])(Mr|Mrs|Ms|Miss|Dr|Jr|Sr|DDS|MD|DVM|PhD)([.]|$|[ ])', ' '), '[ ]+', ' ')),",
				"          gender = iif(in(['m','male'], lower(trim(gender))), 'Masculino', iif(in(['f','female'], lower(trim(gender))), 'Femenino', 'Otro')),",
				"          date_of_birth = coalesce(toDate(date_of_birth,'MMMM d, yyyy'), toDate(date_of_birth,'MM-dd-yy'), toDate(date_of_birth,'dd-MMM-yyyy'), toDate(date_of_birth,'yyyy-MM-dd'), toDate(date_of_birth,'MM/dd/yyyy')),",
				"          phone = iifNull(regexReplace(phone,'[^0-9]',''), ''),",
				"          email = iifNull(replace(replace(lower(trim(email)),',','.'),'gmial.com','gmail.com'), ''),",
				"          address = iifNull(trim(address), ''),",
				"          insurance_provider = case(regexReplace(lower(trim(insurance_provider)),'[^a-z]','')=='medicaid', 'Medicaid', regexReplace(lower(trim(insurance_provider)),'[^a-z]','')=='medicare', 'Medicare', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'cigna'), 'Cigna', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'blue'), 'BlueCross', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'aetna'), 'Aetna', regexReplace(lower(trim(insurance_provider)),'[^a-z]','')=='uhc' || startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'united'), 'UnitedHealth', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'self'), 'Self-pay', '')) ~> limpiezaPacientes",
				"limpiezaPacientes derive(date_of_birth = iif(!isNull(date_of_birth) && date_of_birth > currentDate(), addMonths(date_of_birth, -1200), date_of_birth),",
				"          phone = iif(iifNull(length(phone),0)==0, toString(null()), phone),",
				"          email = iif(iifNull(length(email),0)==0, toString(null()), email),",
				"          address = iif(iifNull(length(address),0)==0, toString(null()), address),",
				"          insurance_provider = iif(iifNull(length(insurance_provider),0)==0, toString(null()), insurance_provider)) ~> vaciosANulo",
				"vaciosANulo derive(nombreClave = lower(regexReplace(full_name,'[^A-Za-z]','')),",
				"          nacimientoClave = iifNull(toString(date_of_birth), 'sin-fecha')) ~> claveDuplicado",
				"claveDuplicado window(over(nombreClave,",
				"          nacimientoClave),",
				"     asc(patient_id, true),",
				"     fila = rowNumber()) ~> numerarDuplicados",
				"numerarDuplicados filter(fila == 1) ~> quedarseConUno",
				"quedarseConUno sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> silverPatients"
			]
		}
	}
}