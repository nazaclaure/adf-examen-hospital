{
	"name": "df_silver_patients",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_patients_sql",
						"type": "DatasetReference"
					},
					"name": "bronzePatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "silverPatients"
				}
			],
			"transformations": [
				{
					"name": "limpiezaPacientes"
				},
				{
					"name": "quitarDuplicados"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronzePatients",
				"bronzePatients derive(patient_id = toInteger(trim(patient_id)),",
				"          full_name = iifNull(trim(full_name), ''),",
				"          gender = iif(in(['m','male'], lower(trim(gender))), 'Masculino', iif(in(['f','female'], lower(trim(gender))), 'Femenino', 'Otro')),",
				"          date_of_birth = coalesce(toDate(date_of_birth,'MMMM d, yyyy'), toDate(date_of_birth,'MM-dd-yy'), toDate(date_of_birth,'dd-MMM-yyyy'), toDate(date_of_birth,'yyyy-MM-dd')),",
				"          phone = iifNull(regexReplace(phone,'[^0-9]',''), ''),",
				"          email = iifNull(replace(replace(lower(trim(email)),',','.'),'gmial.com','gmail.com'), ''),",
				"          address = iifNull(trim(address), ''),",
				"          insurance_provider = case(regexReplace(lower(trim(insurance_provider)),'[^a-z]','')=='medicaid', 'Medicaid', regexReplace(lower(trim(insurance_provider)),'[^a-z]','')=='medicare', 'Medicare', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'cigna'), 'Cigna', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'blue'), 'BlueCross', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'aetna'), 'Aetna', regexReplace(lower(trim(insurance_provider)),'[^a-z]','')=='uhc' || startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'united'), 'UnitedHealth', startsWith(regexReplace(lower(trim(insurance_provider)),'[^a-z]',''),'self'), 'Self-pay', '')) ~> limpiezaPacientes",
				"limpiezaPacientes aggregate(groupBy(patient_id),",
				"     full_name = first(full_name),",
				"          gender = first(gender),",
				"          date_of_birth = first(date_of_birth),",
				"          phone = first(phone),",
				"          email = first(email),",
				"          address = first(address),",
				"          insurance_provider = first(insurance_provider)) ~> quitarDuplicados",
				"quitarDuplicados sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> silverPatients"
			]
		}
	}
}